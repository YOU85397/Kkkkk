BOT_TOKEN = '8188507461:AAHvHf3LkjKFd1Hz1_LofRipAyGipQpZ-4A'  # تم تحديث التوكن هنا
bot = telebot.TeleBot(BOT_TOKEN)

# إعدادات الأمان
كلمة_السر = "853974"
المستخدمين_المسموح_لهم = {"VINEX_XD"}  # تم تغيير المستخدم المسموح له هنا
المستخدمين_مفعلين = set()

# لتخزين آخر رسالة تم نشرها
آخر_رسالة = {
